# Environment variables for development
# Copy this file to .env.local and update with your local settings

# Environment Mode
NODE_ENV=development

# API Configuration - Development
VITE_API_URL=http://localhost:3040/api/v1
VITE_API_KEY=your-api-key-here
VITE_PORT=3040

# App Configuration
VITE_APP_NAME=Homestay Web App
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=development

# Development Settings
VITE_DEV_MODE=true
VITE_DEBUG=true
VITE_LOG_LEVEL=debug

# Database (if using server-side)
DATABASE_URL=your-database-url-here

# Authentication (if using auth services)
VITE_AUTH_DOMAIN=your-auth-domain
VITE_AUTH_CLIENT_ID=your-auth-client-id




# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
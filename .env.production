# Environment variables for production
# These variables will be loaded by Vite and prefixed with VITE_ will be available in the client

# API Configuration - Production
VITE_API_URL=http://localhost:3040/api/v1
VITE_API_KEY=prod-api-key-here
VITE_PORT=3040
# App Configuration
VITE_APP_NAME=TanStack App
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=production

# Production Settings
VITE_DEV_MODE=false
VITE_DEBUG=false
VITE_LOG_LEVEL=error

# Database (if using server-side)
DATABASE_URL=your-production-database-url-here

# Authentication (if using auth services)
VITE_AUTH_DOMAIN=your-production-auth-domain
VITE_AUTH_CLIENT_ID=your-production-auth-client-id





# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret